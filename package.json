{
  "name": "ekittens",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.worker.json && vite build",
    "deploy": "npm run verify && vite build && wrangler deploy",
    "test": "vitest run",
    "format": "prettier --write .",
    "shots": "node scripts/shots.mjs",
    "shots:diff": "node scripts/diff.mjs",
    "verify": "tsc && tsc -p tsconfig.worker.json && prettier --check . && vitest run",
    "icons": "node scripts/icons.mjs",
    "avatars": "node scripts/avatars.mjs",
    "sounds": "node scripts/sounds.mjs"
  },
  "dependencies": {
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/workers-types": "^5.20261106.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
